diff --git a/alacritty/src/semantic_trace.rs b/alacritty/src/semantic_trace.rs
new file mode 100644
index 0000000..d53797a
--- /dev/null
+++ b/alacritty/src/semantic_trace.rs
@@ -0,0 +1,311 @@
+//! Trusted execution chrome: bounded facts, never application text.
+use std::collections::{BTreeMap, VecDeque};
+use std::time::{Duration, Instant};
+use clap::{Args, ValueEnum};
+use serde::{Deserialize, Serialize};
+use alacritty_terminal::index::Point;
+use crate::display::color::Rgb;
+use crate::renderer::rects::RenderRect;
+
+pub const MAX_SCOPES: usize = 2048;
+pub const LANES: usize = 4;
+const BINS: usize = 256;
+const BURST: Duration = Duration::from_millis(700);
+
+#[derive(ValueEnum, Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+pub enum Kind { Human, Codex, Fabric, Jev, Search, Read, Edit, Tool, Test, Verify, Worker, ShellCommand }
+#[derive(ValueEnum, Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+pub enum Phase { Start, Update, Finish }
+#[derive(ValueEnum, Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+pub enum Status { Active, Passed, Failed, Cancelled }
+
+#[derive(Args, Serialize, Deserialize, Debug, Clone, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub struct SemanticEvent {
+    #[clap(long)] pub id: u32,
+    #[clap(long)] pub parent: Option<u32>,
+    #[clap(long, value_enum)] pub kind: Kind,
+    #[clap(long, value_enum)] pub phase: Phase,
+    #[clap(long, value_enum)] pub status: Status,
+    /// Safe decision count, capped at 65535.
+    #[clap(long, default_value_t = 0)] pub count: u16,
+    /// Aggregate uncertainty in permille, never question content.
+    #[clap(long, default_value_t = 0, value_parser = clap::value_parser!(u16).range(0..=1000))]
+    pub uncertainty: u16,
+}
+
+#[derive(Debug)]
+struct Scope {
+    event: SemanticEvent,
+    start: u64,
+    end: Option<u64>,
+    lane: usize,
+    alternate: bool,
+    changed: Instant,
+}
+
+#[derive(Default)]
+pub struct SemanticTrace {
+    scopes: VecDeque<Scope>,
+    next_legacy: u32,
+    legacy_shell: Option<u32>,
+    legacy_agent: Option<u32>,
+}
+
+impl SemanticTrace {
+    pub fn reset(&mut self) { *self = Self::default(); }
+    pub fn validate(&self, event: &SemanticEvent) -> Result<(), String> {
+        if event.id == 0 || event.uncertainty > 1000 { return Err("invalid bounded metric or id".into()); }
+        match event.phase {
+            Phase::Start => {
+                if event.status != Status::Active || self.scopes.iter().any(|s| s.event.id == event.id) {
+                    return Err("start requires a fresh id and active status".into());
+                }
+                if let Some(parent) = event.parent {
+                    if parent == event.id || !self.scopes.iter().any(|s| s.event.id == parent && s.event.status == Status::Active) {
+                        return Err("parent must be an existing active scope".into());
+                    }
+                }
+                if self.scopes.len() == MAX_SCOPES && self.scopes.iter().all(|s| s.event.status == Status::Active) {
+                    return Err("active scope budget exhausted".into());
+                }
+            },
+            Phase::Update | Phase::Finish => {
+                let scope = self.scopes.iter().find(|s| s.event.id == event.id).ok_or("unknown scope")?;
+                if scope.event.kind != event.kind || scope.event.parent != event.parent || scope.event.status != Status::Active {
+                    return Err("scope identity is immutable; terminal scopes cannot reopen".into());
+                }
+                if (event.phase == Phase::Finish) == (event.status == Status::Active) {
+                    return Err("invalid phase/status transition".into());
+                }
+            },
+        }
+        Ok(())
+    }
+    pub fn apply(&mut self, event: SemanticEvent, anchor: u64, alternate: bool, now: Instant) {
+        if event.phase == Phase::Start {
+            if self.scopes.len() == MAX_SCOPES {
+                if let Some(index) = self.scopes.iter().position(|s| s.event.status != Status::Active) { self.scopes.remove(index); }
+            }
+            let floor = event.parent.and_then(|id| self.scopes.iter().find(|s| s.event.id == id)).map_or(0, |s| s.lane + 1);
+            // The human/control owner shares the ordinary-shell base lane.
+            let lane = if event.kind == Kind::Human { 0 } else {
+                (floor..LANES).find(|lane| !self.scopes.iter().any(|s| s.event.status == Status::Active && s.event.kind != Kind::Human && s.lane == *lane)).unwrap_or(LANES - 1)
+            };
+            self.scopes.push_back(Scope { event, start: anchor, end: None, lane, alternate, changed: now });
+        } else if let Some(scope) = self.scopes.iter_mut().find(|s| s.event.id == event.id) {
+            if event.phase == Phase::Finish { scope.end = Some(anchor); }
+            scope.event = event;
+            scope.changed = now;
+        }
+    }
+    pub fn animating(&self, now: Instant) -> bool {
+        self.scopes.iter().rev().take(32).any(|s| now.saturating_duration_since(s.changed) < BURST)
+    }
+    /// Legacy tokens share this state model; shell and agent lifetimes remain separate.
+    pub fn legacy(&mut self, token: crate::shell_gutter::ShellGutterEvent) -> Option<SemanticEvent> {
+        use crate::shell_gutter::ShellGutterEvent as E;
+        if token == E::Reset { self.reset(); return None; }
+        let (kind, finish, failed) = match token {
+            E::CodexStart | E::CampaignLaunch => (Kind::Codex, false, false),
+            E::CodexStop | E::Complete => (Kind::Codex, true, false),
+            E::CommandStart => (Kind::ShellCommand, false, false),
+            E::CommandPass => (Kind::ShellCommand, true, false),
+            E::CommandFail => (Kind::ShellCommand, true, true),
+            E::Failed => (Kind::Codex, true, true),
+            E::Read => (Kind::Read, false, false),
+            E::Search => (Kind::Search, false, false),
+            E::Edit | E::CompositionStart => (Kind::Edit, false, false),
+            E::Test | E::Verify | E::QualificationStart | E::WrenchStart => (Kind::Verify, false, false),
+            E::Reasoning => (Kind::Codex, false, false),
+            E::CandidateReject | E::WrenchReject => (Kind::Tool, true, true),
+            _ => (Kind::Tool, false, false),
+        };
+        // Transient tokens must never consume the surrounding agent lifetime.
+        let lifetime = matches!(token, E::CodexStart | E::CampaignLaunch | E::CodexStop | E::Complete | E::Failed | E::Reasoning | E::CommandStart | E::CommandPass | E::CommandFail);
+        let slot = if kind == Kind::ShellCommand { &mut self.legacy_shell } else { &mut self.legacy_agent };
+        let previous = if !lifetime { None } else if finish { slot.take() } else { *slot };
+        self.next_legacy = self.next_legacy.wrapping_add(1).max(1);
+        let id = previous.unwrap_or(0x8000_0000 | self.next_legacy);
+        let known = self.scopes.iter().find(|s| s.event.id == id);
+        let event = SemanticEvent {
+            id, parent: known.and_then(|s| s.event.parent), kind: known.map_or(kind, |s| s.event.kind),
+            phase: if previous.is_none() { Phase::Start } else if finish { Phase::Finish } else { Phase::Update },
+            status: if previous.is_some() && finish { if failed { Status::Failed } else { Status::Passed } } else { Status::Active },
+            count: 0, uncertainty: 0,
+        };
+        if lifetime && !finish { *slot = Some(id); }
+        Some(event)
+    }
+
+    /// Bounded O(MAX_SCOPES + BINS) projection, independent of history length.
+    pub fn project(&self, anchors: &BTreeMap<u64, Point>, history: usize, offset: usize,
+        rows: usize, width: f32, height: f32, left: f32, top: f32, cell_width: f32, cell_height: f32,
+        alternate: bool, now: Instant) -> Vec<RenderRect> {
+        let mut rects = Vec::with_capacity(1024);
+        let mut bins: [Option<(u8, Rgb, bool)>; BINS] = [None; BINS];
+        let mut results: [Option<(u8, Rgb)>; BINS] = [None; BINS];
+        let total = (history + rows).max(1);
+        // Scale execution geometry with the terminal font, not tiny fixed pixels.
+        // The number column is unchanged; extra reservation belongs to topology.
+        let lane_step = cell_width * 1.5;
+        let stroke = (cell_width / 5.).max(2.);
+        let plane_left = (left - cell_width * 6.5).max(0.);
+        let bottom = top + rows as f32 * cell_height;
+        let mut latest = [0u32; LANES];
+        for scope in &self.scopes { latest[scope.lane] = scope.event.id; }
+        for (scope_index, scope) in self.scopes.iter().enumerate() {
+            if scope.alternate != alternate { continue; }
+            let Some(start) = anchors.get(&scope.start) else { continue; };
+            let end = scope.end.and_then(|id| anchors.get(&id)).map_or(if scope.event.status == Status::Active { rows as i32 - 1 } else { start.line.0 }, |p| p.line.0);
+            let a = start.line.0.min(end);
+            let b = start.line.0.max(end);
+            let result_color = color(scope.event.kind, scope.event.status);
+            let color = color(scope.event.kind, if scope.event.status == Status::Failed { Status::Failed } else { Status::Active });
+            let priority = if scope.event.status == Status::Active { 3 } else if scope.event.kind == Kind::Jev { 2 } else { 1 };
+            let index = |line: i32| ((line + history as i32).max(0) as usize * BINS / total).min(BINS - 1);
+            for bin in &mut bins[index(a)..=index(b)] {
+                if bin.is_none_or(|(p, _, _)| priority >= p) { *bin = Some((priority, color, scope.event.kind == Kind::Jev)); }
+            }
+            if scope.event.status != Status::Active {
+                let bin = &mut results[index(b)];
+                let priority = if scope.event.status == Status::Failed { 2 } else { 1 };
+                if bin.is_none_or(|(p, _)| priority >= p) { *bin = Some((priority, result_color)); }
+            }
+            // Keep the rectangle budget fixed even when many same-row events settle.
+            if scope_index + 128 < self.scopes.len() { continue; }
+            let y = (top + (a + offset as i32) as f32 * cell_height).max(top);
+            let end_y = (top + (b + offset as i32 + 1) as f32 * cell_height).min(bottom);
+            if end_y <= y { continue; }
+            let x = plane_left + scope.lane as f32 * lane_step;
+            rects.push(RenderRect::new(x, y, stroke, end_y - y, color, 0.55));
+            let head = top + (start.line.0 + offset as i32) as f32 * cell_height + cell_height * 0.5;
+            if head >= top && head < bottom {
+                rects.push(RenderRect::new(x - stroke, head - stroke * 1.5, stroke * 3., stroke * 3., color, 0.9));
+                if let Some(parent) = scope.event.parent.and_then(|id| self.scopes.iter().find(|s| s.event.id == id)) {
+                    let parent_x = plane_left + parent.lane as f32 * lane_step;
+                    rects.push(RenderRect::new(parent_x.min(x), head, (x - parent_x).abs().max(stroke), stroke, color, 0.45));
+                }
+                if scope.event.kind == Kind::Jev {
+                    let segments = (usize::from(scope.event.count).checked_ilog2().unwrap_or(0) + 2).min(5);
+                    for i in 0..segments {
+                        let age = now.saturating_duration_since(scope.changed);
+                        let burst = if age < BURST { (age.as_millis() / 100) as u32 } else { 0 };
+                        let amplitude = stroke * (2. + ((u32::from(scope.event.uncertainty) + i * 173 + burst * 3) % 5) as f32);
+                        rects.push(RenderRect::new(x + i as f32 * lane_step / 5., head - amplitude * 0.5, stroke * 0.8, amplitude, color, 0.85));
+                    }
+                }
+            }
+            if scope.event.status != Status::Active {
+                let tail = (end_y - 2.).max(y);
+                rects.push(RenderRect::new(x, tail, stroke * if scope.event.status == Status::Failed { 3. } else { 2. }, stroke, result_color, 0.9));
+            }
+            // A text-safe ownership wash; alpha stays below 2%.
+            if latest[scope.lane] == scope.event.id {
+                rects.push(RenderRect::new(left, y, (width - left - 8.).max(0.), end_y - y, color, 0.012));
+            }
+            let age = now.saturating_duration_since(scope.changed);
+            if age < BURST && scope.event.status != Status::Active {
+                let progress = age.as_secs_f32() / BURST.as_secs_f32();
+                rects.push(RenderRect::new(left, end_y - 1., 40. * progress, 1., color, (1. - progress) * 0.35));
+            }
+        }
+        let map_height = (height - 2. * top).max(1.);
+        for (i, bin) in bins.into_iter().enumerate() {
+            if let Some((_, color, jev)) = bin {
+                rects.push(RenderRect::new(width - 7., top + i as f32 * map_height / BINS as f32,
+                    if jev { 2. } else { 3. }, (map_height / BINS as f32).max(1.), color, 0.7));
+            }
+        }
+        for (i, result) in results.into_iter().enumerate() {
+            if let Some((_, color)) = result { rects.push(RenderRect::new(width - 3., top + i as f32 * map_height / BINS as f32, 2., (map_height / BINS as f32).max(1.), color, 0.85)); }
+        }
+        let viewport_y = top + history.saturating_sub(offset) as f32 / total as f32 * map_height;
+        rects.push(RenderRect::new(width - 8., viewport_y, 1., (rows as f32 / total as f32 * map_height).max(2.), Rgb::new(203, 213, 225), 0.65));
+        // Fixed-enum top instrumentation: four lane occupancy segments, no text injection.
+        for lane in 0..LANES {
+            let scope = self.scopes.iter().rev().find(|s| s.lane == lane && s.event.status == Status::Active);
+            if let Some(scope) = scope { rects.push(RenderRect::new(plane_left + lane as f32 * lane_step, 1., stroke * 3., stroke * 2., color(scope.event.kind, scope.event.status), 0.8)); }
+        }
+        rects
+    }
+}
+
+fn color(kind: Kind, status: Status) -> Rgb {
+    match status {
+        Status::Failed => Rgb::new(251, 113, 133),
+        Status::Passed => Rgb::new(167, 243, 208),
+        Status::Cancelled => Rgb::new(100, 116, 139),
+        Status::Active => match kind {
+            Kind::Codex | Kind::Edit => Rgb::new(196, 181, 253),
+            Kind::Fabric | Kind::Search | Kind::Tool => Rgb::new(103, 232, 249),
+            Kind::Read | Kind::ShellCommand => Rgb::new(147, 197, 253),
+            Kind::Test | Kind::Verify => Rgb::new(254, 243, 199),
+            Kind::Jev => Rgb::new(112, 192, 186),
+            Kind::Worker => Rgb::new(122, 166, 218),
+            Kind::Human => Rgb::new(203, 213, 225),
+        },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn event(id: u32, parent: Option<u32>) -> SemanticEvent { SemanticEvent { id, parent, kind: Kind::Fabric, phase: Phase::Start, status: Status::Active, count: 0, uncertainty: 0 } }
+    #[test] fn transitions_and_parallel_lanes() {
+        let mut trace = SemanticTrace::default(); let now = Instant::now();
+        for e in [event(1, None), event(2, Some(1)), event(3, Some(1))] { assert!(trace.validate(&e).is_ok()); trace.apply(e, 1, false, now); }
+        assert_eq!(trace.scopes.iter().map(|s| s.lane).collect::<Vec<_>>(), vec![0,1,2]);
+        assert!(trace.validate(&event(4, Some(4))).is_err());
+        assert!(trace.validate(&event(5, Some(999))).is_err());
+        let mut e = event(2, Some(1)); e.phase = Phase::Finish; e.status = Status::Failed;
+        assert!(trace.validate(&e).is_ok()); trace.apply(e.clone(), 2, false, now);
+        assert!(trace.validate(&e).is_err());
+        assert!(trace.animating(now)); assert!(!trace.animating(now + BURST)); trace.reset(); assert!(trace.scopes.is_empty());
+    }
+    #[test] fn legacy_rejections_do_not_consume_agent_and_reasoning_updates() {
+        use crate::shell_gutter::ShellGutterEvent as E;
+        let mut trace = SemanticTrace::default(); let now = Instant::now();
+        let main = trace.legacy(E::CodexStart).unwrap();
+        assert!(trace.validate(&main).is_ok()); trace.apply(main.clone(), 1, false, now);
+        let reasoning = trace.legacy(E::Reasoning).unwrap();
+        assert_eq!(reasoning.id, main.id); assert_eq!(reasoning.phase, Phase::Update);
+        assert!(trace.validate(&reasoning).is_ok()); trace.apply(reasoning, 1, false, now);
+        let rejection = trace.legacy(E::CandidateReject).unwrap();
+        assert_ne!(rejection.id, main.id); assert_eq!(rejection.phase, Phase::Start);
+        assert!(trace.validate(&rejection).is_ok()); trace.apply(rejection, 1, false, now);
+        let complete = trace.legacy(E::Complete).unwrap();
+        assert_eq!(complete.id, main.id); assert_eq!(complete.status, Status::Passed);
+        assert!(trace.validate(&complete).is_ok());
+    }
+    #[test] fn lattice_geometry_scales_and_stays_outside_transcript() {
+        let mut trace = SemanticTrace::default(); let now = Instant::now();
+        for id in 1..=4 { let mut e = event(id, if id == 1 { None } else { Some(1) }); e.kind = Kind::Jev; e.count = 64; trace.apply(e, 1, false, now); }
+        let anchors = BTreeMap::from([(1, Point::new(alacritty_terminal::index::Line(0), alacritty_terminal::index::Column(0)))]);
+        for cell in [8., 16.] {
+            let left = cell * 11.;
+            let rects = trace.project(&anchors, 0, 0, 10, 800., 400., left, 6., cell, cell * 2., false, now + BURST);
+            let rails: Vec<_> = rects.iter().filter(|r| r.alpha == 0.55).collect();
+            assert_eq!(rails.len(), 4);
+            for pair in rails.windows(2) { assert!(pair[1].x - pair[0].x >= cell * 1.5); }
+            assert!(rails.iter().all(|r| r.width >= 2.));
+            for r in rects.iter().filter(|r| r.x < left && r.alpha >= 0.45) { assert!(r.x + r.width <= left, "chrome must not overlap PTY text"); }
+        }
+    }
+    #[test] fn bounded_retention() {
+        let mut trace = SemanticTrace::default(); let now = Instant::now();
+        for id in 1..=MAX_SCOPES as u32 + 10 { let mut e = event(id, None); trace.apply(e.clone(), 1, false, now); e.phase = Phase::Finish; e.status = Status::Passed; trace.apply(e, 1, false, now); }
+        assert_eq!(trace.scopes.len(), MAX_SCOPES);
+    }
+    #[test] fn protocol_fails_closed() {
+        let e = event(1, None); let mut value = serde_json::to_value(&e).unwrap();
+        value["label"] = serde_json::json!("untrusted text"); assert!(serde_json::from_value::<SemanticEvent>(value).is_err());
+        for kind in ["human","codex","fabric","jev","search","read","edit","tool","test","verify","worker","shell-command"] {
+            let mut value = serde_json::to_value(&e).unwrap(); value["kind"] = serde_json::json!(kind); assert!(serde_json::from_value::<SemanticEvent>(value).is_ok());
+        }
+        let mut value = serde_json::to_value(&e).unwrap(); value["kind"] = serde_json::json!("arbitrary"); assert!(serde_json::from_value::<SemanticEvent>(value).is_err());
+    }
+}
