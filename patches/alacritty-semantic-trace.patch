@@ -0,0 +1,31 @@
+use alacritty_terminal::grid::{Dimensions, Grid};
+use alacritty_terminal::index::{Column, Line, Point};
+use alacritty_terminal::term::cell::{Cell, Flags};
+#[test]
+fn semantic_anchor_scroll_reflow_and_eviction() {
+    let mut grid = Grid::<Cell>::new(3, 8, 10);
+    grid.cursor.point = Point::new(Line(0), Column(6));
+    grid[Line(0)][Column(6)].c = 'x';
+    grid[Line(0)][Column(7)].flags.insert(Flags::WRAPLINE);
+    let id = grid.semantic_anchor();
+    grid.scroll_up::<alacritty_terminal::vte::ansi::Color>(&(Line(0)..Line(3)), 1);
+    assert_eq!(grid.semantic_anchors[&id].line, Line(-1));
+    grid.resize::<alacritty_terminal::vte::ansi::Color>(true, 3, 4);
+    let point = grid.semantic_anchors[&id];
+    assert_eq!(grid[point].c, 'x');
+    assert_eq!(grid[point].semantic_anchor(), id);
+    assert!(point.column.0 < 4);
+    for _ in 0..20 { grid.scroll_up::<alacritty_terminal::vte::ansi::Color>(&(Line(0)..Line(3)), 1); }
+    grid.semantic_validate();
+    assert!(!grid.semantic_anchors.contains_key(&id));
+    assert_eq!(grid.history_size(), 10);
+}
+#[test]
+fn repaint_preserves_execution_position() {
+    let mut grid = Grid::<Cell>::new(3, 8, 10);
+    let id = grid.semantic_anchor();
+    grid[Point::new(Line(0), Column(0))] = Cell::default();
+    grid.semantic_validate();
+    assert_eq!(grid.semantic_anchors[&id], Point::new(Line(0), Column(0)));
+    assert_eq!(grid[Point::new(Line(0), Column(0))].semantic_anchor(), id);
+}
