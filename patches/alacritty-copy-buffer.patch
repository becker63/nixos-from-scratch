@@ -79,2 +81,63 @@ const DAMAGE_RECT_COLOR: Rgb = Rgb::new(255, 0, 255);
 
+/// Lowest-cost automatic detection for interactive coding-agent harnesses.
+const SHELL_GUTTER_HARNESS_POLL: Duration = Duration::from_millis(250);
+const SHELL_GUTTER_HARNESS_NAMES: &[&str] = &[
+    "aider", "amp", "claude", "claude-code", "codex", "codex-code-mode-host",
+    "codex-ext", ".codex-wrapped", "copilot", "copilot-cli", "cursor-agent", "gemini",
+    "goose", "kilocode", "opencode", "pi", "qwen", "qwen-code", "roo", "roo-code",
+];
+
+#[derive(Default)]
+struct ShellGutterHarnessCache {
+    last_checked: Option<Instant>,
+    active: bool,
+}
+
+fn shell_gutter_agent_harness_active() -> bool {
+    #[cfg(target_os = "linux")]
+    {
+        static CACHE: OnceLock<Mutex<ShellGutterHarnessCache>> = OnceLock::new();
+        let mut cache = CACHE.get_or_init(Default::default).lock().expect("harness cache poisoned");
+        if let Some(last_checked) = cache.last_checked {
+            if last_checked.elapsed() < SHELL_GUTTER_HARNESS_POLL {
+                return cache.active;
+            }
+        }
+
+        let mut processes = vec![std::process::id()];
+        let mut inspected = 0;
+        cache.active = false;
+        while let Some(pid) = processes.pop() {
+            inspected += 1;
+            if inspected > 256 {
+                break;
+            }
+
+            let children = format!("/proc/{pid}/task/{pid}/children");
+            let Ok(children) = fs::read_to_string(children) else { continue };
+            for child in children.split_whitespace().filter_map(|pid| pid.parse::<u32>().ok()) {
+                let comm = format!("/proc/{child}/comm");
+                if let Ok(name) = fs::read_to_string(comm) {
+                    if SHELL_GUTTER_HARNESS_NAMES
+                        .iter()
+                        .any(|harness| name.trim().eq_ignore_ascii_case(harness))
+                    {
+                        cache.active = true;
+                        break;
+                    }
+                }
+                processes.push(child);
+            }
+            if cache.active {
+                break;
+            }
+        }
+        cache.last_checked = Some(Instant::now());
+        cache.active
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    false
+}
+
 #[derive(Debug)]
