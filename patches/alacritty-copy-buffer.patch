+    /// Copy the primary terminal buffer, optionally clearing it after a successful copy.
+    #[cfg(unix)]
+    pub fn copy_primary_buffer(
+        &mut self,
+        clipboard: &mut Clipboard,
+        clear: bool,
+    ) -> Result<(), String> {
+        let mut terminal = self.terminal.lock();
+        let text = terminal.primary_buffer_to_string();
+
+        clipboard.try_store(ClipboardType::Clipboard, text)?;
+
+        if clear {
+            terminal.clear_primary_buffer();
+            self.dirty = true;
+            if self.display.window.has_frame {
+                self.display.window.request_redraw();
+            }
+        }
+
+        Ok(())
+    }
