+/// Zed-style terminal line-number gutter width in character cells.
+const SHELL_GUTTER_COLUMNS: usize = 6;
+// Give the gutter a visible cool tint from an empty buffer onward. Heat is
+// reserved for actual capacity pressure, while the cursor is a small flash
+// of lemon so it remains easy to pick out when the terminal is busy.
+const SHELL_GUTTER_LINE_NUMBER: Rgb = Rgb::new(125, 211, 252);
+const SHELL_GUTTER_ACTIVE_LINE_NUMBER: Rgb = Rgb::new(254, 243, 199);
+const SHELL_GUTTER_TEPID: Rgb = Rgb::new(196, 181, 253);
+const SHELL_GUTTER_WARM: Rgb = Rgb::new(251, 191, 36);
+const SHELL_GUTTER_HOT: Rgb = Rgb::new(251, 113, 133);
+
+fn shell_gutter_blend(start: Rgb, end: Rgb, amount: f32) -> Rgb {
+    let amount = amount.clamp(0., 1.);
+    let blend = |start: u8, end: u8| {
+        (f32::from(start) + (f32::from(end) - f32::from(start)) * amount).round() as u8
+    };
+    Rgb::new(blend(start.r, end.r), blend(start.g, end.g), blend(start.b, end.b))
+}
+
+fn shell_gutter_temperature(history_usage: f32, active: bool) -> Rgb {
+    let cool = if active { SHELL_GUTTER_ACTIVE_LINE_NUMBER } else { SHELL_GUTTER_LINE_NUMBER };
+    match history_usage {
+        usage if usage <= 0.20 => cool,
+        usage if usage <= 0.55 => shell_gutter_blend(cool, SHELL_GUTTER_TEPID, (usage - 0.20) / 0.35),
+        usage if usage <= 0.85 => shell_gutter_blend(SHELL_GUTTER_TEPID, SHELL_GUTTER_WARM, (usage - 0.55) / 0.30),
+        usage => shell_gutter_blend(SHELL_GUTTER_WARM, SHELL_GUTTER_HOT, (usage - 0.85) / 0.15),
+    }
+}
+
+fn shell_gutter_shimmer(color: Rgb, line_number: usize) -> Rgb {
+    static START: OnceLock<Instant> = OnceLock::new();
+    let elapsed = START.get_or_init(Instant::now).elapsed().as_secs_f32();
+    // A slow diagonal glint turns static line numbers into a quiet, readable
+    // motion cue without changing the terminal grid or its color palette.
+    let phase = elapsed * 2.4 + line_number as f32 * 0.37;
+    let strength = ((phase.sin() + 1.) * 0.5) * 0.16;
+    shell_gutter_blend(color, SHELL_GUTTER_ACTIVE_LINE_NUMBER, strength)
+}
