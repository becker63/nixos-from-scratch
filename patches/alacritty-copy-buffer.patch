+    fn primary_buffer_includes_scrollback_and_can_be_cleared() {
+        let size = TermSize::new(8, 3);
+        let mut term = Term::new(Config::default(), &size, VoidListener);
+
+        for (index, text) in ["one", "two", "three", "four"].into_iter().enumerate() {
+            for character in text.chars() {
+                term.input(character);
+            }
+
+            if index != 3 {
+                term.carriage_return();
+                term.newline();
+            }
+        }
+
+        assert_eq!(term.primary_buffer_to_string(), "one\ntwo\nthree\nfour");
+        assert_eq!(term.history_size(), 1);
+
