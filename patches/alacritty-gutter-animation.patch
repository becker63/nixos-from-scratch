+#[cfg(test)]
+mod gutter_geometry_tests {
+    use super::*;
+
+    #[test]
+    fn zero_padding_reserves_the_gutter_once() {
+        let plain = SizeInfo::new(160., 100., 10., 10., 0., 0., false);
+        let gutter = SizeInfo::new_with_gutter(160., 100., 10., 10., 0., 0., false);
+
+        assert_eq!(plain.columns(), 16);
+        assert_eq!(gutter.columns(), 10);
+        assert_eq!(gutter.padding_x(), 60.);
+    }
+
+    #[test]
+    fn configured_dimensions_round_trip_through_window_pixels() {
+        let config = UiConfig::default();
+        let dimensions = Dimensions { columns: 40, lines: 10 };
+        let pixels = window_size(&config, dimensions, 10., 20., 1.);
+        let padding = config.window.padding(1.);
+        let size = SizeInfo::new_with_gutter(
+            pixels.width as f32,
+            pixels.height as f32,
+            10.,
+            20.,
+            padding.0,
+            padding.1,
+            config.window.dynamic_padding,
+        );
+
+        assert_eq!(size.columns(), dimensions.columns);
+        assert_eq!(size.screen_lines(), dimensions.lines);
+    }
+}
