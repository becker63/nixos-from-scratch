+        (SocketMessage::GutterEvent(..), SocketReply::GutterEvent(Ok(()))) => Ok(()),
+        (SocketMessage::GutterEvent(..), SocketReply::GutterEvent(Err(err))) => {
+            Err(IoError::other(err.clone()))
+        },
         // Ignore requests without reply.
         _ => Ok(()),
     }
@@ -248,5 +261,6 @@ pub fn socket_prefix() -> String {
 #[derive(Serialize, Deserialize, Debug)]
 pub enum SocketReply {
     CopyBuffer(Result<(), String>),
+    GutterEvent(Result<(), String>),
     GetConfig(String),
 }
