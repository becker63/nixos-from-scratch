index 0000000000000000000000000000000000000000..b55382c464ddbaa1aeb25248161df2df2dc5a915
--- /dev/null
+++ b/alacritty/src/shell_gutter.rs
@@ -0,0 +1,592 @@
+//! Per-window semantic gutter animation and its bounded IPC vocabulary.
+
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+use clap::ValueEnum;
+use serde::{Deserialize, Serialize};
+
+use crate::display::color::Rgb;
+
+pub const COLUMNS: usize = 6;
+pub const FRAME_INTERVAL: Duration = Duration::from_millis(100);
+
+const ACTIVITY_LIFETIME: Duration = Duration::from_millis(1_800);
+const PULSE_LIFETIME: Duration = Duration::from_millis(2_400);
+const MODE_LIFETIME: Duration = Duration::from_secs(3);
+const SCOPE_LIFETIME: Duration = PULSE_LIFETIME;
+const MAX_PENDING_EVENTS: usize = 32;
+
+const NUMBER: Rgb = Rgb::new(100, 116, 139);
+const ACTIVE_NUMBER: Rgb = Rgb::new(203, 213, 225);
+const RAIL: Rgb = Rgb::new(71, 85, 105);
+const CYAN: Rgb = Rgb::new(103, 232, 249);
+const BLUE: Rgb = Rgb::new(147, 197, 253);
+const VIOLET: Rgb = Rgb::new(196, 181, 253);
+const CREAM: Rgb = Rgb::new(254, 243, 199);
+const GREEN: Rgb = Rgb::new(167, 243, 208);
+const CORAL: Rgb = Rgb::new(251, 113, 133);
+
+/// Semantic events accepted by `alacritty msg gutter-event`.
+///
+/// This intentionally contains no arbitrary strings. The experiment can
+/// select a visual state, but it cannot inject content into the terminal UI.
+#[derive(ValueEnum, Serialize, Deserialize, Debug, Clone, Copy, PartialEq, Eq)]
+#[serde(rename_all = "kebab-case")]
+pub enum ShellGutterEvent {
+    Reset,
+    CodexStart,
+    CodexStop,
+    Reasoning,
+    Search,
+    Read,
+    Edit,
+    Tool,
+    Test,
+    Verify,
+    Complete,
+    Failed,
+    CommandStart,
+    CommandPass,
+    CommandFail,
+    CampaignLaunch,
+    CandidateStart,
+    CandidateReject,
+    CandidatePass,
+    QualificationStart,
+    Qualified,
+    CompositionStart,
+    CompositionPass,
+    WrenchStart,
+    WrenchReject,
+}
+
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+enum SemanticMode {
+    #[default]
+    Idle,
+    Reasoning,
+    Search,
+    Read,
+    Edit,
+    Tool,
+    Verify,
+    Campaign,
+    Settled,
+    Failed,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum PulseKind {
+    Launch,
+    Packet,
+    Passed,
+    Rejected,
+    Qualified,
+    WrenchRejected,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct Pulse {
+    kind: PulseKind,
+    line: usize,
+    started_at: Instant,
+}
+
+#[derive(Debug, Clone, Copy)]
+struct CommandScope {
+    start: usize,
+    end: Option<usize>,
+    passed: Option<bool>,
+    finished_at: Option<Instant>,
+}
+
+/// Fully sampled appearance for one visible gutter row.
+#[derive(Debug, Clone, Copy)]
+pub struct ShellGutterVisual {
+    pub number_color: Rgb,
+    pub rail_color: Rgb,
+    pub rail: char,
+    pub strip_width: f32,
+    pub strip_alpha: f32,
+}
+
+/// Small, display-owned animation state; all timing remains outside the grid.
+pub struct ShellGutterAnimation {
+    pending: VecDeque<(ShellGutterEvent, Instant)>,
+    session_active: bool,
+    session_hint: bool,
+    mode: SemanticMode,
+    mode_started_at: Instant,
+    last_active_line: Option<usize>,
+    last_activity_at: Option<Instant>,
+    output_velocity: f32,
+    pulse: Option<Pulse>,
+    scope: Option<CommandScope>,
+    alternate_screen: bool,
+}
+
+impl Default for ShellGutterAnimation {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl ShellGutterAnimation {
+    pub fn new() -> Self {
+        Self::new_at(Instant::now())
+    }
+
+    fn new_at(now: Instant) -> Self {
+        Self {
+            pending: VecDeque::new(),
+            session_active: false,
+            session_hint: false,
+            mode: SemanticMode::Idle,
+            mode_started_at: now,
+            last_active_line: None,
+            last_activity_at: None,
+            output_velocity: 0.,
+            pulse: None,
+            scope: None,
+            alternate_screen: false,
+        }
+    }
+
+    /// Queue an event for attachment to the cursor line at the next draw.
+    pub fn push_event(&mut self, event: ShellGutterEvent, now: Instant) {
+        if event == ShellGutterEvent::Reset {
+            *self = Self::new_at(now);
+            return;
+        }
+
+        if self.pending.len() == MAX_PENDING_EVENTS {
+            self.pending.pop_front();
+        }
+        self.pending.push_back((event, now));
+    }
+
+    /// Observe the current line and apply queued semantic events to it.
+    pub fn update(
+        &mut self,
+        now: Instant,
+        active_line: Option<usize>,
+        output_activity: bool,
+        alternate_screen: bool,
+        session_hint: bool,
+    ) {
+        self.session_hint = session_hint;
+
+        // Line anchors cannot survive swapping grids. Reset transient spatial
+        // state instead of attaching it to unrelated alternate-screen rows.
+        if self.alternate_screen != alternate_screen {
+            self.last_active_line = active_line;
+            self.last_activity_at = None;
+            self.output_velocity = 0.;
+            self.pulse = None;
+            self.scope = None;
+            self.alternate_screen = alternate_screen;
+        }
+
+        if let Some(line) = active_line {
+            if let Some(previous) = self.last_active_line {
+                let forward_delta = line.saturating_sub(previous);
+                if forward_delta > 0 || output_activity {
+                    let delta = forward_delta.max(1) as f32;
+                    let elapsed = self
+                        .last_activity_at
+                        .map_or(0.2, |last| now.saturating_duration_since(last).as_secs_f32())
+                        .max(0.016);
+                    let instantaneous = (delta / elapsed).min(80.);
+                    self.output_velocity = self.output_velocity.mul_add(0.72, instantaneous * 0.28);
+                    self.last_activity_at = Some(now);
+                } else if line < previous {
+                    // Cursor-up movement, reflow, and history truncation are
+                    // discontinuities, not high-velocity output.
+                    self.output_velocity = 0.;
+                    self.last_activity_at = None;
+                }
+            } else if output_activity {
+                self.last_activity_at = Some(now);
+            }
+            self.last_active_line = Some(line);
+        }
+
+        let event_line = active_line.or(self.last_active_line).unwrap_or(1);
+        while let Some((event, event_at)) = self.pending.pop_front() {
+            self.apply_event(event, event_at, event_line);
+        }
+
+        if self
+            .pulse
+            .is_some_and(|pulse| now.saturating_duration_since(pulse.started_at) >= PULSE_LIFETIME)
+        {
+            self.pulse = None;
+        }
+        if self.scope.is_some_and(|scope| {
+            scope
+                .finished_at
+                .is_some_and(|finished| now.saturating_duration_since(finished) >= SCOPE_LIFETIME)
+        }) {
+            self.scope = None;
+        }
+        if !self.session_active
+            && !self.session_hint
+            && self.mode != SemanticMode::Idle
+            && now.saturating_duration_since(self.mode_started_at) >= MODE_LIFETIME
+        {
+            self.mode = SemanticMode::Idle;
+        }
+    }
+
+    pub fn animating(&self, now: Instant) -> bool {
+        let mode_animating = matches!(
+            self.mode,
+            SemanticMode::Reasoning
+                | SemanticMode::Search
+                | SemanticMode::Tool
+                | SemanticMode::Verify
+                | SemanticMode::Campaign
+        ) && (self.session_active
+            || self.session_hint
+            || now.saturating_duration_since(self.mode_started_at) < MODE_LIFETIME);
+
+        mode_animating
+            || !self.pending.is_empty()
+            || self
+                .last_activity_at
+                .is_some_and(|last| now.saturating_duration_since(last) < ACTIVITY_LIFETIME)
+            || self.pulse.is_some_and(|pulse| {
+                now.saturating_duration_since(pulse.started_at) < PULSE_LIFETIME
+            })
+    }
+
+    pub fn semantic_active(&self) -> bool {
+        self.session_active
+            || self.session_hint
+            || self.mode != SemanticMode::Idle
+            || self.scope.is_some()
+    }
+
+    pub fn visual(
+        &self,
+        now: Instant,
+        line: usize,
+        viewport_line: usize,
+        screen_lines: usize,
+        active: bool,
+    ) -> ShellGutterVisual {
+        let active_line = self.last_active_line.unwrap_or(line);
+        let distance = line.abs_diff(active_line) as f32;
+        let mode_elapsed = now.saturating_duration_since(self.mode_started_at).as_secs_f32();
+        let activity_age = self
+            .last_activity_at
+            .map_or(f32::INFINITY, |last| now.saturating_duration_since(last).as_secs_f32());
+
+        let speed = (self.output_velocity / 18.).clamp(0., 1.);
+        let trail_length = 4. + speed * 5.;
+        let wake = if line <= active_line && distance <= trail_length {
+            (1. - distance / trail_length) * (1. - activity_age / 1.8).clamp(0., 1.)
+        } else {
+            0.
+        };
+
+        let semantic = match self.mode {
+            SemanticMode::Search => {
+                let scan = (mode_elapsed * 7.) % screen_lines.max(1) as f32;
+                let scan_distance = (viewport_line as f32 - scan).abs();
+                (-scan_distance.powi(2) / 2.8).exp() * 0.75
+            },
+            SemanticMode::Verify => {
+                let standing = ((distance * 1.7 - mode_elapsed * 4.2).cos() + 1.) * 0.5;
+                standing * (-distance / 4.).exp() * 0.55
+            },
+            SemanticMode::Reasoning => {
+                let breath = ((mode_elapsed * 1.35).sin() + 1.) * 0.5;
+                breath * (-distance / 2.4).exp() * 0.38
+            },
+            SemanticMode::Read => (-distance / 1.5).exp() * 0.4,
+            SemanticMode::Edit | SemanticMode::Tool => (-distance / 2.8).exp() * 0.45,
+            SemanticMode::Campaign => {
+                ((mode_elapsed * 0.9).sin() + 1.) * 0.16 * (-distance / 5.).exp()
+            },
+            SemanticMode::Failed => (-distance / 3.).exp() * 0.5,
+            SemanticMode::Idle | SemanticMode::Settled => 0.,
+        };
+
+        let (pulse_intensity, pulse_symbol, pulse_color) =
+            self.pulse.map_or((0., None, None), |pulse| {
+                let elapsed = now.saturating_duration_since(pulse.started_at).as_secs_f32();
+                let radius = elapsed * 8.;
+                let wave_distance = (line.abs_diff(pulse.line) as f32 - radius) / 1.35;
+                let decay = (1. - elapsed / PULSE_LIFETIME.as_secs_f32()).clamp(0., 1.);
+                let intensity = (-wave_distance.powi(2)).exp() * decay;
+                let symbol = (line == pulse.line && elapsed < 1.35).then_some(match pulse.kind {
+                    PulseKind::Launch => '◈',
+                    PulseKind::Packet => '◇',
+                    PulseKind::Passed | PulseKind::Qualified => '✓',
+                    PulseKind::Rejected | PulseKind::WrenchRejected => '×',
+                });
+                let color = match pulse.kind {
+                    PulseKind::Launch => VIOLET,
+                    PulseKind::Packet => CYAN,
+                    PulseKind::Passed | PulseKind::Qualified => GREEN,
+                    PulseKind::Rejected | PulseKind::WrenchRejected => CORAL,
+                };
+                (intensity, symbol, Some(color))
+            });
+
+        let (scope_intensity, scope_symbol, scope_color) =
+            self.scope.map_or((0., None, None), |scope| {
+                let end = scope.end.unwrap_or(active_line.max(scope.start));
+                if line < scope.start || line > end {
+                    return (0., None, None);
+                }
+                let symbol = if scope.start == end && line == end {
+                    scope.passed.map(|passed| if passed { '✓' } else { '×' }).or(Some('╭'))
+                } else if line == scope.start {
+                    Some('╭')
+                } else if line == end && scope.end.is_some() {
+                    scope.passed.map(|passed| if passed { '✓' } else { '×' }).or(Some('╰'))
+                } else {
+                    Some('│')
+                };
+                let color = match scope.passed {
+                    Some(true) => GREEN,
+                    Some(false) => CORAL,
+                    None => BLUE,
+                };
+                (0.34, symbol, Some(color))
+            });
+
+        let intensity = wake.max(semantic).max(pulse_intensity).max(scope_intensity).clamp(0., 1.);
+        let mode_color = match self.mode {
+            SemanticMode::Search | SemanticMode::Tool => CYAN,
+            SemanticMode::Read => BLUE,
+            SemanticMode::Reasoning | SemanticMode::Edit | SemanticMode::Campaign => VIOLET,
+            SemanticMode::Verify => CREAM,
+            SemanticMode::Settled => GREEN,
+            SemanticMode::Failed => CORAL,
+            SemanticMode::Idle => RAIL,
+        };
+        let semantic_color = pulse_color.or(scope_color).unwrap_or(mode_color);
+        let rail_color = blend(RAIL, semantic_color, 0.2 + intensity * 0.8);
+        let number_color = if active { blend(NUMBER, ACTIVE_NUMBER, 0.7) } else { NUMBER };
+
+        let rail = pulse_symbol.or(scope_symbol).unwrap_or_else(|| {
+            if active && self.semantic_active() {
+                '◆'
+            } else if intensity >= 0.72 {
+                '┃'
+            } else if intensity >= 0.4 {
+                '╎'
+            } else if intensity >= 0.16 {
+                '┊'
+            } else if intensity >= 0.05 {
+                '·'
+            } else {
+                '│'
+            }
+        });
+
+        ShellGutterVisual {
+            number_color,
+            rail_color,
+            rail,
+            strip_width: 1. + intensity * 3.,
+            strip_alpha: if intensity > 0.02 { 0.12 + intensity * 0.5 } else { 0.05 },
+        }
+    }
+
+    fn apply_event(&mut self, event: ShellGutterEvent, now: Instant, line: usize) {
+        let mut pulse = None;
+        self.mode_started_at = now;
+        match event {
+            ShellGutterEvent::Reset => return,
+            ShellGutterEvent::CodexStart => {
+                self.session_active = true;
+                self.mode = SemanticMode::Reasoning;
+            },
+            ShellGutterEvent::CodexStop | ShellGutterEvent::Complete => {
+                self.session_active = false;
+                self.mode = SemanticMode::Settled;
+                pulse = Some(PulseKind::Passed);
+            },
+            ShellGutterEvent::Reasoning => self.mode = SemanticMode::Reasoning,
+            ShellGutterEvent::Search => self.mode = SemanticMode::Search,
+            ShellGutterEvent::Read => self.mode = SemanticMode::Read,
+            ShellGutterEvent::Edit => self.mode = SemanticMode::Edit,
+            ShellGutterEvent::Tool => self.mode = SemanticMode::Tool,
+            ShellGutterEvent::Test | ShellGutterEvent::Verify => self.mode = SemanticMode::Verify,
+            ShellGutterEvent::Failed => {
+                self.session_active = false;
+                self.mode = SemanticMode::Failed;
+                pulse = Some(PulseKind::Rejected);
+            },
+            ShellGutterEvent::CommandStart => {
+                self.mode = SemanticMode::Tool;
+                self.scope =
+                    Some(CommandScope { start: line, end: None, passed: None, finished_at: None });
+            },
+            ShellGutterEvent::CommandPass | ShellGutterEvent::CommandFail => {
+                let passed = event == ShellGutterEvent::CommandPass;
+                let scope = self.scope.get_or_insert(CommandScope {
+                    start: line,
+                    end: None,
+                    passed: None,
+                    finished_at: None,
+                });
+                scope.end = Some(line.max(scope.start));
+                scope.passed = Some(passed);
+                scope.finished_at = Some(now);
+                self.mode = if passed { SemanticMode::Settled } else { SemanticMode::Failed };
+                pulse = Some(if passed { PulseKind::Passed } else { PulseKind::Rejected });
+            },
+            ShellGutterEvent::CampaignLaunch => {
+                self.session_active = true;
+                self.mode = SemanticMode::Campaign;
+                pulse = Some(PulseKind::Launch);
+            },
+            ShellGutterEvent::CandidateStart => {
+                self.mode = SemanticMode::Tool;
+                pulse = Some(PulseKind::Packet);
+            },
+            ShellGutterEvent::CandidateReject => {
+                self.mode = SemanticMode::Reasoning;
+                pulse = Some(PulseKind::Rejected);
+            },
+            ShellGutterEvent::CandidatePass => {
+                self.mode = SemanticMode::Verify;
+                pulse = Some(PulseKind::Passed);
+            },
+            ShellGutterEvent::QualificationStart | ShellGutterEvent::WrenchStart => {
+                self.mode = SemanticMode::Verify;
+            },
+            ShellGutterEvent::Qualified => {
+                self.mode = SemanticMode::Settled;
+                pulse = Some(PulseKind::Qualified);
+            },
+            ShellGutterEvent::CompositionStart => {
+                self.mode = SemanticMode::Edit;
+                pulse = Some(PulseKind::Packet);
+            },
+            ShellGutterEvent::CompositionPass => {
+                self.mode = SemanticMode::Settled;
+                pulse = Some(PulseKind::Passed);
+            },
+            ShellGutterEvent::WrenchReject => {
+                self.mode = SemanticMode::Settled;
+                pulse = Some(PulseKind::WrenchRejected);
+            },
+        }
+        if let Some(kind) = pulse {
+            self.pulse = Some(Pulse { kind, line, started_at: now });
+        }
+    }
+}
+
+fn blend(start: Rgb, end: Rgb, amount: f32) -> Rgb {
+    let amount = amount.clamp(0., 1.);
+    let channel = |start: u8, end: u8| {
+        (f32::from(start) + (f32::from(end) - f32::from(start)) * amount).round() as u8
+    };
+    Rgb::new(channel(start.r, end.r), channel(start.g, end.g), channel(start.b, end.b))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn command_scope_closes_with_a_stable_result() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.update(start, Some(10), false, false, false);
+        gutter.push_event(ShellGutterEvent::CommandStart, start);
+        gutter.update(start, Some(10), false, false, false);
+        assert_eq!(gutter.visual(start, 10, 0, 20, true).rail, '╭');
+
+        let finished = start + Duration::from_millis(200);
+        gutter.update(finished, Some(13), true, false, false);
+        gutter.push_event(ShellGutterEvent::CommandPass, finished);
+        gutter.update(finished, Some(13), false, false, false);
+        assert_eq!(gutter.visual(finished, 11, 1, 20, false).rail, '│');
+        assert_eq!(gutter.visual(finished, 13, 3, 20, true).rail, '✓');
+    }
+
+    #[test]
+    fn output_wake_fades_after_activity_stops() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.push_event(ShellGutterEvent::CodexStart, start);
+        gutter.update(start, Some(20), true, false, false);
+        let moved = start + Duration::from_millis(80);
+        gutter.update(moved, Some(21), true, false, false);
+
+        let wake = gutter.visual(moved, 20, 4, 20, false).strip_alpha;
+        let faded = gutter.visual(moved + Duration::from_secs(2), 20, 4, 20, false).strip_alpha;
+        assert!(wake > faded);
+    }
+
+    #[test]
+    fn same_line_output_refreshes_a_capped_scrollback_wake() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.push_event(ShellGutterEvent::CodexStart, start);
+        gutter.update(start, Some(20), true, false, false);
+
+        let refreshed = start + Duration::from_secs(2);
+        gutter.update(refreshed, Some(20), true, false, false);
+        assert!(gutter.visual(refreshed, 20, 4, 20, true).strip_alpha > 0.2);
+    }
+
+    #[test]
+    fn standalone_semantic_mode_has_a_bounded_animation_lease() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.push_event(ShellGutterEvent::Search, start);
+        gutter.update(start, Some(7), false, false, false);
+        assert!(gutter.animating(start + Duration::from_secs(2)));
+
+        let expired = start + MODE_LIFETIME;
+        gutter.update(expired, Some(7), false, false, false);
+        assert!(!gutter.animating(expired));
+        assert!(!gutter.semantic_active());
+    }
+
+    #[test]
+    fn alternate_screen_transition_clears_spatial_scope() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.push_event(ShellGutterEvent::CommandStart, start);
+        gutter.update(start, Some(4), false, false, false);
+        assert!(gutter.scope.is_some());
+
+        gutter.update(start, Some(1), false, true, false);
+        assert!(gutter.scope.is_none());
+    }
+
+    #[test]
+    fn reset_stops_a_semantic_session() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.push_event(ShellGutterEvent::CampaignLaunch, start);
+        gutter.update(start, Some(7), false, false, false);
+        assert!(gutter.semantic_active());
+
+        gutter.push_event(ShellGutterEvent::Reset, start);
+        assert!(!gutter.semantic_active());
+        assert!(!gutter.animating(start + Duration::from_secs(3)));
+    }
+
+    #[test]
+    fn failure_ends_a_campaign_session() {
+        let start = Instant::now();
+        let mut gutter = ShellGutterAnimation::new_at(start);
+        gutter.push_event(ShellGutterEvent::CampaignLaunch, start);
+        gutter.update(start, Some(7), false, false, false);
+        gutter.push_event(ShellGutterEvent::Failed, start);
+        gutter.update(start, Some(7), false, false, false);
+        assert!(!gutter.session_active);
+    }
+}
