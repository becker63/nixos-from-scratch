#!/usr/bin/env bash
set -euo pipefail

action="${1:-get}"
device="kbd_backlight"

case "$action" in
  get)
    brightnessctl \
      --machine-readable \
      --class leds \
      --device "$device" \
      info |
      awk -F, '{ sub(/%$/, "", $4); print $4 }'
    ;;
  set)
    value="${2:-}"
    if [[ ! "$value" =~ ^([0-9]{1,3})(\.[0-9]+)?$ ]]; then
      printf 'keyboard brightness must be a number from 0 to 100\n' >&2
      exit 2
    fi

    percent=$((10#${BASH_REMATCH[1]}))
    if ((percent > 100)); then
      percent=100
    fi

    brightnessctl \
      --quiet \
      --class leds \
      --device "$device" \
      --min-value=0 \
      set "${percent}%"
    ;;
  *)
    printf 'usage: %s {get|set PERCENT}\n' "$0" >&2
    exit 2
    ;;
esac
