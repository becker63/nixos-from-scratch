    alsa = {
      enable = true;
      support32Bit = true;
    };

    pulse.enable = true; # required for pavucontrol
    jack.enable = false;

    wireplumber.enable = true;
  };

  services.blueman.enable = true;

  services.tailscale = {
    enable = true;
    #openFirewall = true;
    #extraUpFlags = [
    #  "--accept-routes=true"
    #  "--accept-dns=false"
    #];
