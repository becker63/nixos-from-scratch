# Generated python bytecode
__pycache__/
*.pyc
.pytest_cache/
.venv/
target/
node_modules/
*.log

# Nix build result symlinks
result
result-*

# direnv's local flake profile cache (nix-direnv); regenerated per environment
.direnv/

# repoclip xonsh function output; regenerable on demand into whatever cwd
repomix-output*.xml

# Scratch working directories and generated Attune validation reports.
.tmp/
packages/pi-runtime/jev-*-results.json

# hardware-configuration.nix is tracked on purpose (nodes/nixos-btw/)

# Runtime harness credentials; never include in flake sources.
.env
.env.*
!.env.example
