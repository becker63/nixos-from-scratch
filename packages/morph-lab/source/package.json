{
  "name": "morph-stanley-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun --no-env-file test --preload ./scripts/offline-preload.ts ./test",
    "typecheck": "tsc --noEmit",
    "smoke:plugin": "bun --no-env-file scripts/smoke-plugin.ts",
    "smoke:real": "bun --no-env-file scripts/smoke-real.ts",
    "lab": "bun --no-env-file src/cli.ts",
    "smoke:pi": "bun --no-env-file scripts/smoke-pi.ts",
    "smoke:selection": "bun --no-env-file scripts/smoke-selection.ts",
    "smoke:systemone": "bun --no-env-file scripts/smoke-systemone.ts",
    "smoke:jev": "bun --no-env-file scripts/smoke-jev.ts",
    "diagnose:systemone": "bun --no-env-file scripts/diagnose-systemone.ts",
    "retry:systemone": "bun --no-env-file scripts/retry-systemone.ts",
    "chat": "bun --no-env-file src/chat.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@morphllm/morphsdk": "0.2.173",
    "zod": "4.4.3",
    "@oh-my-pi/pi-catalog": "18.6.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "bun-types": "1.4.2"
  }
}
